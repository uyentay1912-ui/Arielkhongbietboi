    /* =========================================================================
       PHẦN C: TRÌNH PHÁT NHẠC "ĐĨA CON CÁ XOAY TRÒN" (MP3 + WEB AUDIO AMBIENT)
       ========================================================================= */
    const musicPlayer = (() => {
      let currentIdx = 0;
      let isPlaying = false;
      let userPaused = false;
      let autoBooted = false;

      let htmlAudio = null;
      let audioCtx = null;
      let synthTimer = null;
      let stepCounter = 0;

      const SYNTH_SCALES = {
        "deep-minor":  [220.0, 261.63, 329.63, 392.0, 493.88, 329.63],
        "abyss-bell":  [293.66, 349.23, 440.0, 523.25, 659.25, 440.0],
        "red-rain":    [196.0, 233.08, 293.66, 349.23, 440.0, 293.66],
        "coral-chime": [261.63, 329.63, 392.0, 493.88, 587.33, 392.0]
      };

      function ensureAudioCtx() {
        try {
          if (!audioCtx) {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (!Ctx) return false;
            audioCtx = new Ctx();
          }
          if (audioCtx.state === "suspended") audioCtx.resume();
          return true;
        } catch (_) {
          return false;
        }
      }

      function stopInternal() {
        if (synthTimer) { clearInterval(synthTimer); synthTimer = null; }
        if (htmlAudio) htmlAudio.pause();
      }

      function playSynthNote(mode) {
        if (!ensureAudioCtx()) return;
        try {
          const notes = SYNTH_SCALES[mode] || SYNTH_SCALES["deep-minor"];
          const freq = notes[stepCounter % notes.length];
          stepCounter++;

          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const sub = audioCtx.createOscillator();
          const gain = audioCtx.createGain();

          osc.type = mode === "red-rain" ? "triangle" : "sine";
          sub.type = "sine";
          osc.frequency.setValueAtTime(freq, now);
          sub.frequency.setValueAtTime(freq * 0.5, now);

          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(0.022, now + 0.48);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.7);

          osc.connect(gain);
          sub.connect(gain);
          gain.connect(audioCtx.destination);

          osc.start(now);
          sub.start(now);
          osc.stop(now + 2.8);
          sub.stop(now + 2.8);
        } catch (_) {}
      }

      function updateUI() {
        const discBtn = document.getElementById("fish-disc-btn");
        const toggleBtn = document.getElementById("music-toggle-btn");
        const stateLabel = document.getElementById("playlist-state");

        discBtn.classList.toggle("is-playing", isPlaying);
        toggleBtn.classList.toggle("is-playing", isPlaying);
        toggleBtn.textContent = isPlaying ? "❚❚" : "▶";
        stateLabel.textContent = isPlaying ? "Đang phát" : "Đang dừng";

        document.querySelectorAll(".track-btn").forEach((btn, idx) => {
          btn.classList.toggle("is-current", idx === currentIdx);
          const ind = btn.querySelector(".track-indicator");
          if (ind) ind.textContent = idx === currentIdx ? (isPlaying ? "♪" : "❚❚") : "";
        });
      }

      function play(index = currentIdx) {
        currentIdx = (index + PLAYLIST.length) % PLAYLIST.length;
        const track = PLAYLIST[currentIdx];
        stopInternal();

        if (track.url && track.url.trim() !== "") {
          if (!htmlAudio) {
            htmlAudio = new Audio();
            htmlAudio.loop = true;
            htmlAudio.volume = 0.55;
          }
          if (htmlAudio.src !== new URL(track.url, window.location.href).href) {
            htmlAudio.src = track.url;
          }
          htmlAudio.play().catch(() => {});
        } else if (ensureAudioCtx()) {
          playSynthNote(track.synthMode);
          synthTimer = setInterval(() => playSynthNote(track.synthMode), 2150);
        }

        isPlaying = true;
        autoBooted = true;
        userPaused = false;
        updateUI();
      }

      function pause(manual = true) {
        stopInternal();
        isPlaying = false;
        if (manual) userPaused = true;
        updateUI();
      }

      function toggle() {
        if (isPlaying) pause(true);
        else play(currentIdx);
      }

      function tryAutoStart() {
        if (autoBooted || userPaused || isPlaying) return;
        play(currentIdx);
      }

      function sfxDrop(freq = 520) {
        if (!isPlaying || !ensureAudioCtx()) return;
        try {
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(freq * 0.86, now);
          osc.frequency.exponentialRampToValueAtTime(freq * 1.24, now + 0.09);
          gain.gain.setValueAtTime(0.018, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.16);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.17);
        } catch (_) {}
      }

      function sfxReveal() {
        if (!isPlaying || !ensureAudioCtx()) return;
        try {
          const now = audioCtx.currentTime;
          [440, 554.37, 659.25, 880].forEach((freq, i) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            const t0 = now + i * 0.10;
            osc.type = "sine";
            osc.frequency.setValueAtTime(freq, t0);
            gain.gain.setValueAtTime(0.0001, t0);
            gain.gain.linearRampToValueAtTime(0.025, t0 + 0.04);
            gain.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.95);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(t0);
            osc.stop(t0 + 1.0);
          });
        } catch (_) {}
      }

      function renderPlaylist() {
        const list = document.getElementById("playlist-items");
        list.innerHTML = "";
        PLAYLIST.forEach((track, idx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "track-btn" + (idx === currentIdx ? " is-current" : "");
          btn.innerHTML = `
            <span class="track-meta">
              <span class="track-name">${track.title}</span>
              <span class="track-sub">${track.artist}</span>
            </span>
            <span class="track-indicator"></span>
          `;
          btn.addEventListener("click", () => {
            play(idx);
            showToast(`Đang phát: ${track.title}`);
          });
          list.appendChild(btn);
        });
        updateUI();
      }

      return { play, pause, toggle, tryAutoStart, renderPlaylist, sfxDrop, sfxReveal };
    })();

