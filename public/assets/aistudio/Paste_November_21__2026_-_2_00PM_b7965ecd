    function initNauticalTicks() {
      const group = document.getElementById("nautical-ticks");
      let lines = "";
      for (let deg = 0; deg < 360; deg += 4) {
        const rad = (deg * Math.PI) / 180;
        const major = deg % 20 === 0;
        const r1 = major ? 426 : 436;
        const r2 = 446;
        const x1 = (420 + r1 * Math.cos(rad)).toFixed(1);
        const y1 = (520 + r1 * Math.sin(rad)).toFixed(1);
        const x2 = (420 + r2 * Math.cos(rad)).toFixed(1);
        const y2 = (520 + r2 * Math.sin(rad)).toFixed(1);
        lines += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke-opacity="${major ? 0.24 : 0.11}"/>`;
      }
      group.innerHTML = lines;
    }

