          <path d="M12 20.4s-7.4-4.7-9.2-9.1C1.4 7.8 3.6 4.5 7 4.5c2 0 3.6 1.1 5 2.8 1.4-1.7 3-2.8 5-2.8 3.4 0 5.6 3.3 4.2 6.8-1.8 4.4-9.2 9.1-9.2 9.1Z"/>
        </svg>`;
      heartBtn.addEventListener("pointerdown", (e) => e.stopPropagation());
      heartBtn.addEventListener("click", (e) => {
        e.stopPropagation();
