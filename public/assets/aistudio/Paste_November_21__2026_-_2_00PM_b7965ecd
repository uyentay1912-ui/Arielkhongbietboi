      `;

      flipper.appendChild(front);
      flipper.appendChild(back);
      slot.appendChild(flipper);

      slot.addEventListener("click", () => {
        if (movedDist > 8) return;
        /* Nếu đang ở Nhịp 5 (dừng ngắm lá vừa rút), chạm thẳng vào lá sẽ mở ngay hồ sơ */
        if (isDrawing && gachaRevealedChar && gachaRevealedChar.id === char.id) {
          finishGachaAndOpenDossier(char);
          return;
        }
        if (isDrawing) return;
        closeAllPopovers();
        if (Math.abs(idx - virtualPos) < 0.34) openDossier(char);
        else goToIndex(idx, true);
      });

      slot.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          if (isDrawing && gachaRevealedChar && gachaRevealedChar.id === char.id) {
            finishGachaAndOpenDossier(char);
            return;
          }
          if (isDrawing) return;
          if (Math.abs(idx - virtualPos) < 0.34) openDossier(char);
          else goToIndex(idx, true);
        }
      });

      return slot;
    }

    function rebuildDeck(preserveIndex = null) {
      const q = searchQuery.trim().toLowerCase();
      filteredChars = CHARACTERS.filter((c) => {
        if (activeTag === "SAVED" && !savedIds.has(c.id)) return false;
        if (activeTag !== "ALL" && activeTag !== "SAVED") {
          const matchedTag = c.tags.some((t) => t.toLowerCase() === activeTag.toLowerCase());
          if (!matchedTag) return false;
        }
        if (!q) return true;
        const hay = `${c.name} ${c.tags.join(" ")} ${formatDepth(c.depth)} ${formatDateVN(c.date)}`.toLowerCase();
        return hay.includes(q);
      });

      const track = document.getElementById("fan-track");
      const emptyState = document.getElementById("empty-state");
      const emptyMsg = document.getElementById("empty-msg");
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");

      track.innerHTML = "";
      cardSlots = [];
      lastCenterIdx = -1;

      if (filteredChars.length === 0) {
        emptyMsg.textContent = activeTag === "SAVED"
          ? "Lưới cá đã lưu đang trống — hãy thả tim vài nhân vật bạn thích nhé."
          : "Vùng nước này chưa có nhân vật nào khớp với bộ lọc hiện tại.";
        emptyState.classList.add("is-visible");
        prevBtn.style.opacity = "0.25";
        nextBtn.style.opacity = "0.25";
        document.getElementById("live-card-status").innerHTML = "<strong>00</strong> / 00";
        return;
      }

      emptyState.classList.remove("is-visible");
      prevBtn.style.opacity = filteredChars.length > 1 ? "1" : "0.3";
      nextBtn.style.opacity = filteredChars.length > 1 ? "1" : "0.3";

      const startIdx = preserveIndex !== null
        ? Math.max(0, Math.min(filteredChars.length - 1, preserveIndex))
        : 0;

      virtualPos = startIdx;
      targetPos = startIdx;

      const frag = document.createDocumentFragment();
      filteredChars.forEach((char, idx) => {
        const el = createSpecimenCard(char, idx);
        frag.appendChild(el);
        cardSlots.push(el);
      });

      track.appendChild(frag);
      renderFan();
    }

    /* =========================================================================
       PHẦN F: HIỆU ỨNG "CÂU CÁ" 5 NHỊP CHẬM RÃI, ĐẦY KỊCH TÍNH (~4.8 GIÂY)
       - Nhịp 1 (0–1050ms): Úp mặt lưng 3D có độ trễ từ rìa vào tâm & gom thành xấp bài
       - Nhịp 2 (1050–1900ms): Tách xấp 2 chiều (±38px, ±6deg), dừng nhịp rồi đan nhập lại + sóng nhẹ
       - Nhịp 3 (1900–2850ms): Xấp bên dưới chìm mờ xuống; 1 lá úp mặt trồi lên giữa + hào quang 1px
       - Nhịp 4 (2850–3800ms): Lật 3D chậm mượt 950ms + vệt ánh xà cừ + 2 vòng sóng đồng tâm 1px
       - Nhịp 5 (3800–4800ms): Giữ 1 giây ngắm thành quả (chạm mở ngay hoặc tự mở Hồ Sơ)
       ========================================================================= */
    function setGachaWhisper(html, clickable = false) {
      const el = document.getElementById("gacha-whisper");
      if (!html) {
        el.classList.remove("is-shown", "is-clickable");
        return;
      }
      el.innerHTML = html;
      el.classList.add("is-shown");
      el.classList.toggle("is-clickable", clickable);
    }

    function finishGachaAndOpenDossier(pickedChar) {
      if (gachaHoldTimer) {
        clearTimeout(gachaHoldTimer);
        gachaHoldTimer = null;
      }
      gachaRevealedChar = null;
      setGachaWhisper("");
      document.getElementById("gacha-halo").classList.remove("is-active");

      cardSlots.forEach((slot) => {
        const flipper = slot.querySelector(".card-flipper");
        flipper.classList.remove("is-cinematic-reveal");
        if (!slot.classList.contains("is-center")) {
          flipper.classList.remove("is-flipped");
        }
      });

      pendingFanRestore = true;
      isDrawing = false;
      openDossier(pickedChar);
    }

    function runFishingGacha() {
      if (isDrawing) return;

      if (filteredChars.length === 0) {
        activeTag = "ALL";
        searchQuery = "";
        document.getElementById("search-input").value = "";
        document.getElementById("search-clear").classList.remove("is-shown");
        syncFilterUI();
        rebuildDeck();
      }

      closeDossier(true);
      isDrawing = true;
      pendingFanRestore = false;
      gachaRevealedChar = null;

      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      if (gachaHoldTimer) { clearTimeout(gachaHoldTimer); gachaHoldTimer = null; }

      const currentIdx = clampIdx(Math.round(virtualPos));
      let pickedIdx = Math.floor(Math.random() * filteredChars.length);
      if (filteredChars.length > 1 && pickedIdx === currentIdx) {
        pickedIdx = (pickedIdx + 1 + Math.floor(Math.random() * (filteredChars.length - 1))) % filteredChars.length;
      }
      const pickedChar = filteredChars[pickedIdx];

      const visibleIndices = [];
      for (let i = 0; i < cardSlots.length; i++) {
        if (Math.abs(i - virtualPos) <= 3.12) visibleIndices.push(i);
      }

      const stageRect = document.querySelector(".stage-wrap").getBoundingClientRect();
      const cx = stageRect.left + stageRect.width / 2;
      const cy = stageRect.top + stageRect.height * 0.45;
      const haloEl = document.getElementById("gacha-halo");

      /* ── NHỊP 1 (0 – 1050ms): Úp mặt lưng chậm từ rìa vào giữa & gom xấp bài ── */
      setGachaWhisper(`<span class="gacha-whisper-accent">◦</span> Đang thu hồi mảnh ký ức...`);
      const maxEdgeDist = visibleIndices.reduce((m, idx) => Math.max(m, Math.abs(idx - currentIdx)), 1);

      visibleIndices.forEach((idx, order) => {
        const slot = cardSlots[idx];
        const flipper = slot.querySelector(".card-flipper");
        const distFromCenter = Math.abs(idx - currentIdx);
        /* Stagger từ các lá ngoài rìa vào lá trung tâm */
        const staggerMs = Math.round((maxEdgeDist - distFromCenter) * 75);
        const offsetX = ((order - (visibleIndices.length - 1) / 2) * 1.8).toFixed(1);
        const offsetY = (12 + order * 1.6).toFixed(1);
        const tilt = ((order - (visibleIndices.length - 1) / 2) * 1.9).toFixed(2);

        slot.classList.remove("is-center", "is-sheen-burst");
        flipper.classList.remove("is-cinematic-reveal");
        slot.style.zIndex = String(24 + order);

        setTimeout(() => {
          slot.style.transition = "transform 0.78s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.60s ease";
          slot.style.transform = `translate3d(${offsetX}px, ${offsetY}px, 0) rotate(${tilt}deg) scale(0.91)`;
          slot.style.opacity = idx === currentIdx ? "1" : "0.88";
          flipper.classList.add("is-flipped");
        }, staggerMs);
      });
      musicPlayer.sfxDrop(420);

      /* ── NHỊP 2 (1050 – 1900ms): Tách xấp 2 chiều (±38px, ±6deg) rồi đan gọn lại ── */
      setTimeout(() => {
        setGachaWhisper(`<span class="gacha-whisper-accent">◦◦</span> Đang thả câu xuống đáy vực...`);

        /* Đảm bảo lá trúng thưởng nằm gọn bên trong xấp bài ở trạng thái úp mặt */
        const pickedSlot = cardSlots[pickedIdx];
        const pickedFlipper = pickedSlot.querySelector(".card-flipper");
        if (!visibleIndices.includes(pickedIdx)) {
          pickedSlot.style.transition = "none";
          pickedFlipper.style.transition = "none";
          pickedFlipper.classList.add("is-flipped");
          pickedSlot.style.visibility = "visible";
          pickedSlot.style.pointerEvents = "auto";
          pickedSlot.dataset.vis = "1";
          pickedSlot.style.transform = "translate3d(0, 14px, 0) rotate(0deg) scale(0.91)";
          pickedSlot.style.opacity = "1";
          void pickedSlot.offsetWidth;
          pickedFlipper.style.transition = "";
          visibleIndices.push(pickedIdx);
        }

        /* Pha 2A: Tách xấp sang hai bên trái/phải */
        visibleIndices.forEach((idx, order) => {
          const slot = cardSlots[idx];
          const isLeft = order % 2 === 0;
          const dx = isLeft ? -38 : 38;
          const rot = isLeft ? -6 : 6;
          slot.style.transition = "transform 0.38s cubic-bezier(0.22, 1, 0.36, 1)";
          slot.style.transform = `translate3d(${dx}px, ${(12 + order * 1.2).toFixed(1)}px, 0) rotate(${rot}deg) scale(0.90)`;
        });
        musicPlayer.sfxDrop(490);

        /* Pha 2B: Dừng nhẹ rồi đan nhập mượt về giữa kèm sóng mềm */
        setTimeout(() => {
          visibleIndices.forEach((idx, order) => {
            const slot = cardSlots[idx];
            const tilt = ((order - (visibleIndices.length - 1) / 2) * 1.1).toFixed(2);
            slot.style.transition = "transform 0.38s cubic-bezier(0.22, 1, 0.36, 1)";
            slot.style.transform = `translate3d(0, ${(12 + order * 1.2).toFixed(1)}px, 0) rotate(${tilt}deg) scale(0.91)`;
          });
          fireWaveRing(cx, cy, "wave-ring-2", true);
          musicPlayer.sfxDrop(560);
        }, 430);
      }, 1050);

      /* ── NHỊP 3 (1900 – 2850ms): Xấp dưới chìm mờ, 1 lá úp trồi lên giữa + hào quang 1px ── */
      setTimeout(() => {
        const pickedSlot = cardSlots[pickedIdx];
        pickedSlot.style.zIndex = "95";
        haloEl.classList.add("is-active");
        setGachaWhisper(`<span class="gacha-whisper-accent">✦</span> Một mảnh ký ức đang trồi lên...`);

        visibleIndices.forEach((idx) => {
          if (idx === pickedIdx) return;
          const slot = cardSlots[idx];
          slot.style.transition = "transform 0.78s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.72s ease";
          slot.style.transform = "translate3d(0, 56px, 0) rotate(0deg) scale(0.86)";
          slot.style.opacity = "0.18";
        });

        pickedSlot.style.transition = "transform 0.85s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease";
        pickedSlot.style.transform = "translate3d(0, -16px, 0) rotate(0deg) scale(1.08)";
        pickedSlot.style.opacity = "1";
        musicPlayer.sfxDrop(620);
      }, 1900);

      /* ── NHỊP 4 (2850 – 3800ms): Lật mặt 3D chậm rãi 950ms + ánh xà cừ + 2 vòng sóng 1px ── */
      setTimeout(() => {
        const pickedSlot = cardSlots[pickedIdx];
        const pickedFlipper = pickedSlot.querySelector(".card-flipper");

        pickedFlipper.classList.add("is-cinematic-reveal");
        pickedFlipper.classList.remove("is-flipped");
        pickedSlot.classList.add("is-center", "is-sheen-burst");

        fireWaveRing(cx, cy, "wave-ring-1", false);
        setTimeout(() => fireWaveRing(cx, cy, "wave-ring-2", true), 190);
        musicPlayer.sfxReveal();

        virtualPos = pickedIdx;
        targetPos = pickedIdx;
        syncCenterAtmosphere(pickedIdx);
      }, 2850);

      /* ── NHỊP 5 (3800 – 4800ms): Dừng 1 giây ngắm thành quả (chạm mở ngay) ── */
      setTimeout(() => {
        gachaRevealedChar = pickedChar;
        setGachaWhisper(
          `<span class="gacha-whisper-accent">✦</span> Đã vớt lên · <strong>${pickedChar.name}</strong> · ${formatDepth(pickedChar.depth)} — Chạm để mở ngay`,
          true
        );

        gachaHoldTimer = setTimeout(() => {
          finishGachaAndOpenDossier(pickedChar);
        }, 1050);
      }, 3800);
    }

    function restoreFanGracefully() {
      if (!pendingFanRestore) return;
      pendingFanRestore = false;

      cardSlots.forEach((slot) => {
        slot.classList.remove("is-sheen-burst");
        const flipper = slot.querySelector(".card-flipper");
        flipper.classList.remove("is-flipped", "is-cinematic-reveal");
        slot.style.transition = "transform 0.56s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.46s ease";
      });

      renderFan();

      setTimeout(() => {
        cardSlots.forEach((slot) => { slot.style.transition = ""; });
      }, 580);
    }

    /* =========================================================================
       PHẦN G: KHUNG HỒ SƠ CHI TIẾT (EDITORIAL DOSSIER — 2 TAB + STICKY FOOTER)
       ========================================================================= */
    function switchDossierTab(tabName) {
      document.querySelectorAll(".dossier-tab-btn").forEach((btn) => {
        const active = btn.dataset.tab === tabName;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
      });
      document.getElementById("panel-bio").classList.toggle("is-active", tabName === "bio");
      document.getElementById("panel-feedback").classList.toggle("is-active", tabName === "feedback");
      document.getElementById("dossier-body").scrollTop = 0;
    }

    function updateDossierStatsUI(char) {
      const rt = charRuntime[char.id];
      const isSaved = savedIds.has(char.id);

      document.getElementById("d-metrics").innerHTML = `
        <span><span class="metric-accent">${isSaved ? "♥" : "♡"}</span> ${rt.likes}</span>
        <span>·</span>
        <span><span class="metric-accent">↗</span> ${rt.chats} lượt chat</span>
        <span>·</span>
        <span>${formatDepth(char.depth)}</span>
      `;
      document.getElementById("d-fb-count").textContent = `(${rt.feedbacks.length})`;
      document.getElementById("d-footer-likes").textContent = String(rt.likes);
      document.getElementById("d-heart-btn").classList.toggle("is-saved", isSaved);
    }

    function renderFeedbackList(charId) {
      const list = document.getElementById("feedback-list");
      const items = charRuntime[charId].feedbacks || [];
      document.getElementById("d-fb-count").textContent = `(${items.length})`;
      list.innerHTML = "";

      if (items.length === 0) {
        list.innerHTML = `<p class="fb-empty font-serif">Chưa có hồi âm nào dưới tầng nước này. Hãy là người đầu tiên nhắn gửi nhé.</p>`;
        return;
      }

      items.forEach((fb) => {
        const card = document.createElement("div");
        card.className = "fb-card";

        const head = document.createElement("div");
        head.className = "fb-card-head";

        const author = document.createElement("span");
        author.className = "fb-author";
        author.textContent = fb.author;

        const time = document.createElement("span");
        time.className = "fb-time tabular";
        time.textContent = fb.time;

        head.appendChild(author);
        head.appendChild(time);

        const body = document.createElement("p");
        body.className = "fb-text";
        body.textContent = fb.text;

        card.appendChild(head);
        card.appendChild(body);
        list.appendChild(card);
      });
    }

    async function openDossier(char) {
      activeDossierChar = char;
      const overlay = document.getElementById("dossier-overlay");

      fillVisual(document.getElementById("d-visual"), char);
      document.getElementById("d-name").textContent = char.name;
      document.getElementById("d-tags").innerHTML = char.tags
        .map((t) => `<span class="archive-tag">${t}</span>`)
        .join("");

      const tokensEl = document.getElementById("d-tokens-note");
      tokensEl.textContent = char.tokensNote || "";
      tokensEl.style.display = char.tokensNote ? "block" : "none";

      const bioContainer = document.getElementById("d-bio");
      bioContainer.innerHTML = "";
      (char.lore || "").split(/\n\s*\n/).forEach((para) => {
        const p = document.createElement("p");
        p.textContent = para.trim();
        bioContainer.appendChild(p);
      });

      updateDossierStatsUI(char);
      renderFeedbackList(char.id);

      const chatBtn = document.getElementById("d-chat-btn");
      chatBtn.href = char.chatUrl || "#";
      document.getElementById("d-chat-label").textContent = `Trò chuyện cùng ${char.name}`;

      switchDossierTab("bio");
      overlay.classList.add("is-open");
      musicPlayer.sfxDrop(620);

      if (hasFirebaseConfig()) {
        await remoteSync.fetchChar(char.id);
        if (activeDossierChar && activeDossierChar.id === char.id) {
          updateDossierStatsUI(char);
          renderFeedbackList(char.id);
        }
      }
    }

    function closeDossier(silent = false) {
      const overlay = document.getElementById("dossier-overlay");
      if (!overlay.classList.contains("is-open")) return;
      overlay.classList.remove("is-open");
      activeDossierChar = null;
      if (!silent) musicPlayer.sfxDrop(420);
      if (pendingFanRestore) {
        setTimeout(restoreFanGracefully, 90);
      }
    }

    function formatNowLabel() {
      const d = new Date();
      return `${padTwo(d.getDate())}/${padTwo(d.getMonth() + 1)} · ${padTwo(d.getHours())}:${padTwo(d.getMinutes())}`;
    }

    /* =========================================================================
       PHẦN H: KHỞI TẠO & SỰ KIỆN TƯƠNG TÁC
       ========================================================================= */
    window.addEventListener("DOMContentLoaded", () => {
      const savedTheme = readJSON(STORAGE_KEYS.theme, "blue-sea");
      const initialTheme = savedTheme === "red-sea" ? "red-sea" : "blue-sea";
      document.documentElement.setAttribute("data-theme", initialTheme);
      document.querySelectorAll("[data-theme-target]").forEach((orb) => {
        orb.classList.toggle("is-active", orb.dataset.themeTarget === initialTheme);
      });

      initNauticalTicks();
      initRotatingQuotes();
      renderDirectoryGroups();
      renderMenuMeta();
      musicPlayer.renderPlaylist();
      syncFilterUI();
      rebuildDeck();

      function handleFirstGesture(e) {
        if (e.target && e.target.closest("#music-toggle-btn")) return;
        musicPlayer.tryAutoStart();
      }
      document.addEventListener("pointerdown", handleFirstGesture, { once: true });
      document.addEventListener("keydown", handleFirstGesture, { once: true });

      /* Đổi 2 chế độ màu Biển Xanh / Red Sea */
      document.querySelectorAll("[data-theme-target]").forEach((orb) => {
        orb.addEventListener("click", () => {
          const theme = orb.dataset.themeTarget;
          document.documentElement.setAttribute("data-theme", theme);
          writeJSON(STORAGE_KEYS.theme, theme);
          document.querySelectorAll("[data-theme-target]").forEach((b) => {
            b.classList.toggle("is-active", b === orb);
          });
          const rect = orb.getBoundingClientRect();
          fireWaveRing(rect.left + rect.width / 2, rect.top + rect.height / 2, "wave-ring-1", false);
          musicPlayer.sfxDrop(theme === "red-sea" ? 440 : 620);
        });
      });

      /* Tìm kiếm trực tiếp */
      const searchInput = document.getElementById("search-input");
      const searchClear = document.getElementById("search-clear");

      searchInput.addEventListener("input", (e) => {
        if (isDrawing) return;
        searchQuery = e.target.value;
        searchClear.classList.toggle("is-shown", searchQuery.length > 0);
        syncFilterUI();
        rebuildDeck();
      });

      searchClear.addEventListener("click", () => {
        searchQuery = "";
        searchInput.value = "";
        searchClear.classList.remove("is-shown");
        syncFilterUI();
        rebuildDeck();
      });

      /* Mục lục 25 tag */
      const dirBtn = document.getElementById("dir-btn");
      const dirPopover = document.getElementById("dir-popover");

      dirBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const willOpen = !dirPopover.classList.contains("is-open");
        closeAllPopovers();
        if (willOpen) {
          dirPopover.classList.add("is-open");
          dirBtn.classList.add("is-open");
          dirBtn.setAttribute("aria-expanded", "true");
        }
      });

      document.getElementById("dir-all-btn").addEventListener("click", () => {
        activeTag = "ALL";
        closeAllPopovers();
        syncFilterUI();
        rebuildDeck();
      });

      function resetAllFilters() {
        activeTag = "ALL";
        searchQuery = "";
        searchInput.value = "";
        searchClear.classList.remove("is-shown");
        syncFilterUI();
        rebuildDeck();
      }
      document.getElementById("clear-filter-pill").addEventListener("click", resetAllFilters);
      document.getElementById("reset-filter-btn").addEventListener("click", resetAllFilters);

      /* Đĩa con cá xoay tròn & nút dừng/phát */
      const fishDiscBtn = document.getElementById("fish-disc-btn");
      const playlistPopover = document.getElementById("playlist-popover");

      fishDiscBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const willOpen = !playlistPopover.classList.contains("is-open");
        closeAllPopovers();
        if (willOpen) {
          playlistPopover.classList.add("is-open");
          fishDiscBtn.setAttribute("aria-expanded", "true");
        }
      });

      document.getElementById("music-toggle-btn").addEventListener("click", (e) => {
        e.stopPropagation();
        musicPlayer.toggle();
      });

      document.addEventListener("click", (e) => {
        if (!e.target.closest("#dir-popover") && !e.target.closest("#dir-btn") &&
            !e.target.closest("#playlist-popover") && !e.target.closest("#fish-disc-btn")) {
          closeAllPopovers();
        }
      });

      /* Khung kính thứ 2 (Menu Overlay ☰) */
      document.getElementById("menu-btn").addEventListener("click", openMenuOverlay);
      document.getElementById("menu-close-btn").addEventListener("click", closeMenuOverlay);
      document.getElementById("menu-overlay").addEventListener("click", (e) => {
        if (e.target.id === "menu-overlay") closeMenuOverlay();
      });

      /* Bấm Câu cá -> đóng menu trước 260ms rồi bắt đầu 5 nhịp chậm rãi */
      document.getElementById("menu-gacha-btn").addEventListener("click", () => {
        closeMenuOverlay();
        setTimeout(runFishingGacha, 260);
      });

      /* Chạm thẳng vào dòng caption ở Nhịp 5 cũng mở ngay hồ sơ */
      document.getElementById("gacha-whisper").addEventListener("click", () => {
        if (isDrawing && gachaRevealedChar) {
          finishGachaAndOpenDossier(gachaRevealedChar);
        }
      });

      document.getElementById("menu-saved-btn").addEventListener("click", () => {
        activeTag = activeTag === "SAVED" ? "ALL" : "SAVED";
        closeMenuOverlay();
        syncFilterUI();
        rebuildDeck();
      });

      const guideAcc = document.getElementById("guide-accordion");
      const guideTrig = document.getElementById("guide-trigger");
      guideTrig.addEventListener("click", () => {
        const opened = guideAcc.classList.toggle("is-open");
        guideTrig.setAttribute("aria-expanded", opened ? "true" : "false");
      });

      document.getElementById("go-page-1-btn").addEventListener("click", () => {
        closeMenuOverlay();
        if (typeof window.arielHooks.goToPage1 === "function") window.arielHooks.goToPage1();
        else showToast("Bản xem trước Trang 3 độc lập — nút này sẽ nối về Trang 1 khi ghép đủ 3 trang.");
      });

      document.getElementById("go-page-2-btn").addEventListener("click", () => {
        closeMenuOverlay();
        if (typeof window.arielHooks.goToPage2 === "function") window.arielHooks.goToPage2();
        else showToast("Bản xem trước Trang 3 độc lập — nút này sẽ nối về mini-game Trang 2 khi ghép.");
      });

      /* Điều hướng quạt bài: nút ‹ ›, kéo/vuốt cảm ứng, lăn chuột & bàn phím */
      document.getElementById("prev-btn").addEventListener("click", () => goToIndex(Math.round(targetPos) - 1, true));
      document.getElementById("next-btn").addEventListener("click", () => goToIndex(Math.round(targetPos) + 1, true));

      const track = document.getElementById("fan-track");

      track.addEventListener("pointerdown", (e) => {
        if (isDrawing || filteredChars.length <= 1) return;
        isPointerDown = true;
        pointerStartX = e.clientX;
        pointerLastX = e.clientX;
        pointerLastTime = performance.now();
        dragStartPos = virtualPos;
        velocity = 0;
        movedDist = 0;
        track.classList.add("is-dragging");
      });

      window.addEventListener("pointermove", (e) => {
        if (!isPointerDown) return;
        const now = performance.now();
        const dt = Math.max(8, now - pointerLastTime);
        const stepDx = e.clientX - pointerLastX;
        const totalDx = e.clientX - pointerStartX;
        const { dragFactor } = getFanMetrics();

        movedDist = Math.max(movedDist, Math.abs(totalDx));
        velocity = stepDx / dt;

        const rawPos = dragStartPos - totalDx / dragFactor;
        const maxBound = Math.max(0, filteredChars.length - 1) + 0.35;
        targetPos = Math.max(-0.35, Math.min(maxBound, rawPos));

        pointerLastX = e.clientX;
        pointerLastTime = now;
        wakeFanLoop();
      }, { passive: true });

      function endDrag() {
        if (!isPointerDown) return;
        isPointerDown = false;
        track.classList.remove("is-dragging");
        const inertia = Math.max(-2.1, Math.min(2.1, -velocity * 1.45));
        const snapped = clampIdx(Math.round(targetPos + inertia));
        goToIndex(snapped, movedDist > 12);
      }

      window.addEventListener("pointerup", endDrag);
      window.addEventListener("pointercancel", endDrag);

      let wheelGuard = 0;
      track.addEventListener("wheel", (e) => {
        if (isDrawing || filteredChars.length <= 1) return;
        if (document.getElementById("dossier-overlay").classList.contains("is-open")) return;
        if (document.getElementById("menu-overlay").classList.contains("is-open")) return;
        const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        if (Math.abs(delta) < 6) return;
        e.preventDefault();
        const now = performance.now();
        if (now - wheelGuard < 130) return;
        wheelGuard = now;
        goToIndex(Math.round(targetPos) + (delta > 0 ? 1 : -1), true);
      }, { passive: false });

      window.addEventListener("keydown", (e) => {
        const dossierOpen = document.getElementById("dossier-overlay").classList.contains("is-open");
        const menuOpen = document.getElementById("menu-overlay").classList.contains("is-open");

        if (e.key === "Escape") {
          if (dossierOpen) closeDossier(false);
          else if (menuOpen) closeMenuOverlay();
          else closeAllPopovers();
          return;
        }
        if (dossierOpen || menuOpen || isDrawing) return;
        const tag = document.activeElement?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        if (e.key === "ArrowLeft") goToIndex(Math.round(targetPos) - 1, true);
        if (e.key === "ArrowRight") goToIndex(Math.round(targetPos) + 1, true);
      });

      /* Hồ sơ chi tiết */
      document.getElementById("d-close-btn").addEventListener("click", () => closeDossier(false));
      document.getElementById("dossier-overlay").addEventListener("click", (e) => {
        if (e.target.id === "dossier-overlay") closeDossier(false);
      });

      document.querySelectorAll(".dossier-tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => switchDossierTab(btn.dataset.tab));
      });

      document.getElementById("d-heart-btn").addEventListener("click", () => {
        if (!activeDossierChar) return;
        toggleLike(activeDossierChar.id);
      });

      document.getElementById("d-chat-btn").addEventListener("click", () => {
        if (!activeDossierChar) return;
        const charId = activeDossierChar.id;
        if (!sessionChatted.has(charId)) {
          sessionChatted.add(charId);
          writeJSON(STORAGE_KEYS.sessionChats, Array.from(sessionChatted));
          charRuntime[charId].chats += 1;
          remoteSync.saveStats(charId);
          updateDossierStatsUI(activeDossierChar);
        }
      });

      const fbTextInput = document.getElementById("fb-text-input");
      const fbCharCount = document.getElementById("fb-char-count");
      const fbAuthorInput = document.getElementById("fb-author-input");

      fbTextInput.addEventListener("input", () => {
        fbCharCount.textContent = `${fbTextInput.value.length} / 300`;
      });

      document.getElementById("feedback-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!activeDossierChar) return;

        const text = fbTextInput.value.trim();
        if (!text) {
          showToast("Hãy viết đôi dòng cảm nhận trước khi gửi nhé.");
          return;
        }

        const now = Date.now();
        const elapsed = Math.floor((now - lastFeedbackSubmitTs) / 1000);
        if (lastFeedbackSubmitTs && elapsed < 15) {
          showToast(`Chờ thêm ${15 - elapsed} giây nữa rồi gửi tiếp nhé.`);
          return;
        }

        const rawAuthor = fbAuthorInput.value.trim();
        const author = rawAuthor || SEA_ALIASES[Math.floor(Math.random() * SEA_ALIASES.length)];
        const entry = {
          author,
          text: text.slice(0, 300),
          time: formatNowLabel(),
          ts: now
        };

        lastFeedbackSubmitTs = now;
        const submitBtn = document.getElementById("fb-submit-btn");
        submitBtn.disabled = true;

        await remoteSync.addFeedback(activeDossierChar.id, entry);
        fbTextInput.value = "";
        fbCharCount.textContent = "0 / 300";
        renderFeedbackList(activeDossierChar.id);
        showToast("Đã thả hồi âm xuống đáy biển ✦");

        setTimeout(() => { submitBtn.disabled = false; }, 1200);
      });

      let resizeTimer = null;
      window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          if (!isDrawing) renderFan();
        }, 90);
      });
    });
  </script>
</body>
</html>