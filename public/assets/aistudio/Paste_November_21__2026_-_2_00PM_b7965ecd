            showToast(`Hãy thay link thật trong SOCIAL_LINKS cho ${item.label}.`);
          }
        });
        socialGrid.appendChild(a);
      });
    }

    function toggleLike(charId, heartEl = null) {
      const willSave = !savedIds.has(charId);
      if (willSave) {
        savedIds.add(charId);
        charRuntime[charId].likes += 1;
      } else {
        savedIds.delete(charId);
        charRuntime[charId].likes = Math.max(0, charRuntime[charId].likes - 1);
      }

      writeJSON(STORAGE_KEYS.savedIds, Array.from(savedIds));
      remoteSync.saveStats(charId);
      musicPlayer.sfxDrop(willSave ? 680 : 420);

      document.querySelectorAll(`.card-heart-btn[data-char-id="${charId}"]`).forEach((btn) => {
        btn.classList.toggle("is-saved", willSave);
        if (btn === heartEl) {
          btn.classList.add("is-bouncing");
          setTimeout(() => btn.classList.remove("is-bouncing"), 240);
        }
      });

      if (activeDossierChar && activeDossierChar.id === charId) {
        updateDossierStatsUI(activeDossierChar);
      }

      syncFilterUI();

      if (activeTag === "SAVED" && !willSave && !isDrawing) {
        rebuildDeck(clampIdx(Math.round(virtualPos)));
      }
    }

    function getFanMetrics() {
      const vw = window.innerWidth;
      if (vw <= 768) {
        const cw = Math.max(224, Math.min(250, vw * 0.65));
        return {
          stepX: cw * 0.64,
          arcDrop: 20,
          rotStep: 8.2,
          scaleDrop: 0.085,
          centerLift: -11,
          dragFactor: cw * 0.80
        };
      }
      return {
        stepX: 206,
        arcDrop: 24,
        rotStep: 7.8,
        scaleDrop: 0.075,
        centerLift: -14,
        dragFactor: 250
      };
    }

    function clampIdx(pos) {
      if (filteredChars.length <= 1) return 0;
      return Math.max(0, Math.min(filteredChars.length - 1, pos));
    }

    function syncCenterAtmosphere(idx) {
      if (idx === lastCenterIdx || !filteredChars[idx]) return;
      lastCenterIdx = idx;
      const char = filteredChars[idx];

      document.getElementById("live-card-status").innerHTML =
        `<strong>${padTwo(idx + 1)}</strong> / ${padTwo(filteredChars.length)} · ${formatDepth(char.depth)}`;

      const ratio = Math.max(0, Math.min(1, (Math.abs(char.depth) - 60) / (3800 - 60)));
      document.documentElement.style.setProperty("--depth-darkness", (0.06 + ratio * 0.44).toFixed(3));
    }

    /* Ảo hóa quạt bài: tối đa 7 lá (|offset| <= 3) được vẽ trong vùng nhìn */
    function renderFan() {
      if (isDrawing || cardSlots.length === 0) return;

      const m = getFanMetrics();
      const nearest = clampIdx(Math.round(virtualPos));
      syncCenterAtmosphere(nearest);

      for (let i = 0; i < cardSlots.length; i++) {
        const slot = cardSlots[i];
        const offset = i - virtualPos;
        const absOff = Math.abs(offset);

        if (absOff > 3.12) {
          if (slot.dataset.vis !== "0") {
            slot.style.visibility = "hidden";
            slot.style.opacity = "0";
            slot.style.pointerEvents = "none";
            slot.classList.remove("is-center");
            slot.dataset.vis = "0";
          }
          continue;
        }

        if (slot.dataset.vis !== "1") {
          slot.style.visibility = "visible";
          slot.style.pointerEvents = "auto";
          slot.dataset.vis = "1";
        }

        const tx = offset * m.stepX;
        const lift = absOff < 1 ? (1 - absOff) * m.centerLift : 0;
        const ty = offset * offset * m.arcDrop + lift;
        const rot = offset * m.rotStep;
        const sc = Math.max(0.74, 1 - absOff * m.scaleDrop);
        const op = Math.max(0.16, 1 - absOff * 0.27);
        const z = 40 - Math.round(absOff * 10);

        slot.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0) rotate(${rot.toFixed(2)}deg) scale(${sc.toFixed(3)})`;
        slot.style.opacity = op.toFixed(3);
        slot.style.zIndex = String(z);
        slot.classList.toggle("is-center", absOff < 0.34);
      }

      /* Xoay nhẹ vòng hải đồ khớp nhịp vuốt trong khi vỏ sò đứng yên kiêu hãnh */
      document.getElementById("nautical-ring").style.transform = `rotate(${(-virtualPos * 5.8).toFixed(2)}deg)`;
    }

    function wakeFanLoop() {
      if (rafId) return;
      function frame() {
        if (isDrawing) { rafId = null; return; }
        const diff = targetPos - virtualPos;
        const lerp = isPointerDown ? 0.36 : 0.145;
        if (!isPointerDown && Math.abs(diff) < 0.0018) {
          virtualPos = targetPos;
          renderFan();
          rafId = null;
          return;
        }
        virtualPos += diff * lerp;
        renderFan();
        rafId = requestAnimationFrame(frame);
      }
      rafId = requestAnimationFrame(frame);
    }

    function goToIndex(idx, withSfx = true) {
      if (isDrawing || filteredChars.length === 0) return;
      const clamped = clampIdx(idx);
      if (clamped !== Math.round(targetPos) && withSfx) {
        musicPlayer.sfxDrop(480 + (clamped % 5) * 28);
      }
      targetPos = clamped;
      wakeFanLoop();
    }

    function createSpecimenCard(char, idx) {
