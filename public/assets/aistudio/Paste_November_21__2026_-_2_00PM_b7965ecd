      const info = document.createElement("div");
      info.className = "card-info";
      const tagsHTML = char.tags.map((t) => `<span class="archive-tag">${t}</span>`).join("");
      info.innerHTML = `
        <h2 class="card-name font-serif">${char.name}</h2>
        <div class="card-tags">${tagsHTML}</div>
      `;
      front.appendChild(info);

      const foot = document.createElement("div");
      foot.className = "card-foot tabular";
      foot.innerHTML = `
        <span class="card-date">${formatDateVN(char.date)}</span>
        <span class="card-depth-badge">
          <span>${formatDepth(char.depth)}</span>
          <span class="tier-glyph" aria-hidden="true">${tier.glyph}</span>
