<!DOCTYPE html>
<html lang="vi" data-theme="blue-sea">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Ariel không biết bơi — Trang 3</title>

  <!-- Google Fonts: Cormorant Garamond (Serif thơ mộng) & Plus Jakarta Sans (UI sắc nét) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet" />

  <style>
    /* =========================================================================
       1. HỆ THỐNG 2 CHẾ ĐỘ MÀU: BIỂN XANH (MẶC ĐỊNH) & RED SEA
       - Tuyệt đối KHÔNG dùng backdrop-filter, <canvas> hay box-shadow nhiều lớp
         để giữ vững 60fps mượt mà trên điện thoại.
       ========================================================================= */
    :root,
    html[data-theme="blue-sea"] {
      --bg-top: #0a1b33;
      --bg-mid: #071326;
      --bg-deep: #050d1a;

      --glass-bg: rgba(7, 20, 39, 0.90);
      --glass-panel-bg: rgba(6, 17, 34, 0.96);
      --glass-elevated: rgba(11, 28, 52, 0.96);
      --glass-highlight: rgba(186, 236, 250, 0.14);

      --card-top: #0b213d;
      --card-bottom: #040d1a;
      --card-back-top: #091d36;
      --card-back-bottom: #030914;
      --scrim: rgba(2, 7, 15, 0.85);

      --text-main: #eef7fc;
      --text-soft: rgba(238, 247, 252, 0.78);
      --text-muted: rgba(238, 247, 252, 0.52);
      --text-dim: rgba(238, 247, 252, 0.30);

      --accent: #a6e3f5;
      --accent-mid: #4eb2d4;
      --accent-glow: rgba(166, 227, 245, 0.22);
      --ray-color: rgba(166, 227, 245, 0.11);
      --ray-soft: rgba(166, 227, 245, 0.035);

      --shell-stroke: #b5e7f7;
      --border-subtle: rgba(166, 227, 245, 0.15);
      --border-card: rgba(166, 227, 245, 0.28);
      --border-card-center: rgba(186, 236, 250, 0.72);
      --border-inner: rgba(166, 227, 245, 0.16);
      --pearl-rim: rgba(228, 249, 255, 0.76);
      --sheen-color: rgba(220, 248, 255, 0.36);
      --crack-color: #d6f5fc;

      --tag-bg: rgba(166, 227, 245, 0.06);
      --tag-border: rgba(166, 227, 245, 0.25);
      --btn-active-bg: rgba(78, 178, 212, 0.20);
      --center-shadow: 0 18px 34px rgba(0, 0, 0, 0.62);
      --depth-darkness: 0.12;
    }

    html[data-theme="red-sea"] {
      --bg-top: #2b0a14;
      --bg-mid: #20070f;
      --bg-deep: #17050a;

      --glass-bg: rgba(36, 9, 18, 0.90);
      --glass-panel-bg: rgba(28, 6, 13, 0.96);
      --glass-elevated: rgba(46, 11, 22, 0.96);
      --glass-highlight: rgba(246, 194, 205, 0.14);

      --card-top: #310b17;
      --card-bottom: #140409;
      --card-back-top: #290913;
      --card-back-bottom: #100307;
      --scrim: rgba(11, 2, 5, 0.86);

      --text-main: #fbf1f3;
      --text-soft: rgba(251, 241, 243, 0.78);
      --text-muted: rgba(251, 241, 243, 0.52);
      --text-dim: rgba(251, 241, 243, 0.30);

      --accent: #f2b4c2;
      --accent-mid: #c85876;
      --accent-glow: rgba(242, 180, 194, 0.24);
      --ray-color: rgba(242, 180, 194, 0.11);
      --ray-soft: rgba(242, 180, 194, 0.035);

      --shell-stroke: #f5c3ce;
      --border-subtle: rgba(242, 180, 194, 0.16);
      --border-card: rgba(242, 180, 194, 0.28);
      --border-card-center: rgba(247, 204, 214, 0.72);
      --border-inner: rgba(242, 180, 194, 0.16);
      --pearl-rim: rgba(255, 232, 238, 0.74);
      --sheen-color: rgba(255, 224, 233, 0.36);
      --crack-color: #fbd9e2;

      --tag-bg: rgba(242, 180, 194, 0.06);
      --tag-border: rgba(242, 180, 194, 0.25);
      --btn-active-bg: rgba(200, 88, 118, 0.22);
      --center-shadow: 0 18px 34px rgba(0, 0, 0, 0.66);
      --depth-darkness: 0.12;
    }

    /* =========================================================================
       2. RESET & KHUNG TOÀN MÀN HÌNH (100vw × 100dvh, CHỐNG TRÀN NGANG)
       ========================================================================= */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg-deep);
      color: var(--text-main);
      font-family: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      transition: background-color 0.5s ease, color 0.4s ease;
    }

    button, input, textarea, a {
      font-family: inherit;
      color: inherit;
    }

    button {
      border: none;
      background: none;
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }

    a { text-decoration: none; }

    .font-serif {
      font-family: "Cormorant Garamond", Georgia, serif;
    }

    .tabular {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.04em;
    }

    /* =========================================================================
       3. HẬU CẢNH ĐẠI DƯƠNG + NỀN VỎ SÒ KIẾN TRÚC & HẢI ĐỒ 1PX CỠ LỚN
       ========================================================================= */
    .ocean-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 52%, var(--bg-deep) 100%);
      transition: background 0.55s ease;
    }

    .god-rays {
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }

    .god-ray {
      position: absolute;
      top: -18%;
      width: 40vw;
      max-width: 430px;
      height: 118vh;
      background: linear-gradient(180deg, var(--ray-color) 0%, var(--ray-soft) 48%, transparent 84%);
      transform-origin: top center;
      animation: rayFloat 13s ease-in-out infinite alternate;
      will-change: opacity;
    }

    .god-ray-1 { left: 10%; transform: rotate(-16deg); }
    .god-ray-2 { right: 6%; width: 32vw; max-width: 340px; transform: rotate(14deg); animation-delay: -6.5s; opacity: 0.65; }

    @keyframes rayFloat {
      0% { opacity: 0.40; }
      100% { opacity: 0.88; }
    }

    .depth-veil {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: radial-gradient(circle at 50% 42%, transparent 20%, #000000 118%);
      opacity: var(--depth-darkness);
      transition: opacity 0.6s ease;
    }

    /* Nền Vỏ Sò + Vòng Cung Hải Đồ cỡ lớn nằm ngay phía sau quạt bài */
    .shell-backdrop {
      position: absolute;
      left: 50%;
      top: 47%;
      width: min(820px, 92vw);
      aspect-ratio: 840 / 660;
      transform: translate3d(-50%, -46%, 0);
      z-index: 2;
      pointer-events: none;
      color: var(--shell-stroke);
      transition: color 0.5s ease;
    }

    .shell-backdrop svg {
      width: 100%;
      height: 100%;
      display: block;
      overflow: visible;
    }

    #nautical-ring {
      transform-origin: 420px 520px;
      will-change: transform;
    }

    /* Vòng hào quang 1px phát nhịp sau lá bài khi rút lên trong nhịp 3 Câu cá */
    .gacha-halo {
      position: absolute;
      left: 50%;
      top: 45%;
      width: 340px;
      height: 340px;
      margin-left: -170px;
      margin-top: -170px;
      border-radius: 50%;
      border: 1px solid var(--accent);
      pointer-events: none;
      z-index: 5;
      opacity: 0;
      transform: scale(0.74);
      will-change: transform, opacity;
      transition: opacity 0.65s ease, transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .gacha-halo::after {
      content: "";
      position: absolute;
      inset: 18px;
      border-radius: 50%;
      border: 1px dashed var(--border-card);
    }

    .gacha-halo.is-active {
      opacity: 0.44;
      transform: scale(1.04);
      animation: haloPulse 2.2s ease-in-out infinite alternate;
    }

    @keyframes haloPulse {
      0% { opacity: 0.24; transform: scale(0.96); }
      100% { opacity: 0.54; transform: scale(1.09); }
    }

    /* Hai vòng sóng 1px đồng tâm bung tỏa (đổi màu & khoảnh khắc lật bài Câu cá) */
    .wave-ring {
      position: fixed;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 1px solid var(--accent);
      pointer-events: none;
      z-index: 400;
      opacity: 0;
      transform: translate3d(-50%, -50%, 0) scale(0.25);
      will-change: transform, opacity;
    }

    .wave-ring.is-firing {
      animation: waveRipple 1.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .wave-ring.is-soft {
      border-color: var(--pearl-rim);
      animation: waveRippleSoft 1.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes waveRipple {
      0% { opacity: 0.90; transform: translate3d(-50%, -50%, 0) scale(0.4); }
      50% { opacity: 0.46; }
      100% { opacity: 0; transform: translate3d(-50%, -50%, 0) scale(48); }
    }

    @keyframes waveRippleSoft {
      0% { opacity: 0.68; transform: translate3d(-50%, -50%, 0) scale(0.35); }
      55% { opacity: 0.32; }
      100% { opacity: 0; transform: translate3d(-50%, -50%, 0) scale(36); }
    }

    /* =========================================================================
       4. HAI VIÊN NGỌC ĐỔI MÀU GÓC DƯỚI PHẢI (KHÔNG CHỮ, NGOÀI MỌI KHUNG KÍNH)
       ========================================================================= */
    .theme-orbs {
      position: fixed;
      right: max(16px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
      z-index: 120;
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .orb-btn {
      position: relative;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.38);
      opacity: 0.68;
      transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.22s ease, border-color 0.22s ease;
    }

    .orb-btn::after {
      content: "";
      position: absolute;
      top: 4px;
      left: 5px;
      width: 6px;
      height: 3.5px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.78);
      transform: rotate(-28deg);
      pointer-events: none;
    }

    .orb-blue {
      background: radial-gradient(circle at 30% 28%, #e4fbff 0%, #41a8cf 56%, #051a33 100%);
      box-shadow: 0 0 12px rgba(166, 227, 245, 0.45);
    }

    .orb-red {
      background: radial-gradient(circle at 30% 28%, #ffe1ea 0%, #c9466a 56%, #2a0612 100%);
      box-shadow: 0 0 12px rgba(242, 180, 194, 0.45);
    }

    .orb-btn:hover { opacity: 1; transform: scale(1.14); }
    .orb-btn:active { transform: scale(0.9); }
    .orb-btn.is-active {
      opacity: 1;
      transform: scale(1.16);
      border-color: #ffffff;
    }

    /* =========================================================================
       5. BỐ CỤC CHÍNH, THANH KÍNH TRÊN CÙNG & DÒNG THÔNG SỐ TẠP CHÍ 2 ĐẦU
       ========================================================================= */
    .page-shell {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      z-index: 10;
      display: flex;
      flex-direction: column;
      padding-top: env(safe-area-inset-top);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .topbar-outer {
      position: relative;
      z-index: 80;
      width: 100%;
      padding: 10px 14px 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      flex-shrink: 0;
    }

    /* Thanh kính chung 1 hàng duy nhất (max-width 900px) */
    .glass-bar {
      width: 100%;
      max-width: 900px;
      height: 46px;
      padding: 0 8px 0 10px;
      border-radius: 14px;
      background-color: var(--glass-bg);
      border: 1px solid var(--border-card);
      box-shadow: inset 0 1px 0 var(--glass-highlight);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background-color 0.45s ease, border-color 0.45s ease;
    }

    /* Cụm 1: Tìm kiếm */
    .bar-search {
      flex: 1;
      min-width: 78px;
      height: 32px;
      padding: 0 9px;
      border-radius: 9px;
      background-color: var(--tag-bg);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      gap: 6px;
      transition: border-color 0.22s ease;
    }

    .bar-search:focus-within { border-color: var(--border-card-center); }
    .bar-search svg { flex-shrink: 0; color: var(--text-muted); }

    .bar-search input {
      width: 100%;
      min-width: 0;
      background: transparent;
      border: none;
      outline: none;
      font-size: 12px;
      font-weight: 300;
      color: var(--text-main);
    }

    .bar-search input::placeholder { color: var(--text-dim); }

    .search-clear-btn {
      display: none;
      flex-shrink: 0;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      color: var(--text-muted);
      font-size: 11px;
      align-items: center;
      justify-content: center;
    }

    .search-clear-btn.is-shown { display: inline-flex; }
    .search-clear-btn:hover { color: var(--text-main); }

    .bar-divider {
      width: 1px;
      height: 20px;
      background-color: var(--border-subtle);
      flex-shrink: 0;
    }

    /* Cụm 2: Nút Mục lục ▾ */
    .dir-btn {
      flex-shrink: 0;
      height: 32px;
      padding: 0 11px;
      border-radius: 9px;
      border: 1px solid var(--border-subtle);
      background-color: transparent;
      color: var(--text-soft);
      font-size: 11.5px;
      font-weight: 400;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      max-width: 150px;
      transition: border-color 0.22s ease, color 0.22s ease, background-color 0.22s ease;
    }

    .dir-btn:hover,
    .dir-btn.is-open,
    .dir-btn.has-filter {
      border-color: var(--border-card-center);
      color: var(--text-main);
      background-color: var(--tag-bg);
    }

    .dir-btn-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .dir-caret {
      font-size: 9px;
      color: var(--accent);
      transition: transform 0.22s ease;
      flex-shrink: 0;
    }

    .dir-btn.is-open .dir-caret { transform: rotate(180deg); }

    /* Cụm 3: Đĩa nhạc con cá xoay tròn + nút dừng/phát */
    .music-cluster {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 5px 2px 3px;
      border-radius: 999px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
    }

    .fish-disc-btn {
      position: relative;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1px solid var(--border-card);
      background: radial-gradient(circle at 50% 50%, var(--card-top) 0%, var(--bg-deep) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      transition: border-color 0.22s ease;
    }

    .fish-disc-btn:hover { border-color: var(--accent); }

    .fish-disc-spinner {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: discSpin 9.5s linear infinite;
      animation-play-state: paused;
      will-change: transform;
    }

    .fish-disc-btn.is-playing .fish-disc-spinner {
      animation-play-state: running;
    }

    @keyframes discSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .music-toggle-btn {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      color: var(--text-soft);
      font-size: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.2s ease, background-color 0.2s ease;
    }

    .music-toggle-btn:hover {
      color: var(--text-main);
      background-color: var(--btn-active-bg);
    }

    .music-toggle-btn.is-playing { color: var(--accent); }

    /* Cụm 4: Nút ☰ bên phải */
    .menu-btn {
      flex-shrink: 0;
      width: 32px;
      height: 32px;
      border-radius: 9px;
      border: 1px solid var(--border-subtle);
      color: var(--text-soft);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.22s ease, color 0.22s ease, background-color 0.22s ease;
    }

    .menu-btn:hover,
    .menu-btn.is-open {
      border-color: var(--border-card-center);
      color: var(--text-main);
      background-color: var(--tag-bg);
    }

    /* Dòng thông số tạp chí cân 2 đầu + trích dẫn xoay mỗi 10 giây */
    .editorial-subbar {
      width: 100%;
      max-width: 900px;
      padding: 2px 6px 8px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .subbar-left {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-shrink: 0;
      flex-wrap: wrap;
    }

    .brand-whisper {
      font-size: 1.08rem;
      font-style: italic;
      font-weight: 500;
      color: var(--text-main);
      letter-spacing: 0.02em;
    }

    .live-card-status {
      font-size: 10.5px;
      font-weight: 300;
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .live-card-status strong {
      color: var(--accent);
      font-weight: 500;
    }

    .active-filter-pill {
      display: none;
      align-items: center;
      gap: 5px;
      padding: 1.5px 8px;
      border-radius: 999px;
      border: 1px solid var(--border-card);
      background-color: var(--btn-active-bg);
      color: var(--text-main);
      font-size: 10px;
    }

    .active-filter-pill.is-shown { display: inline-flex; }

    .active-filter-pill button {
      font-size: 9.5px;
      color: var(--accent);
      padding-left: 2px;
    }

    /* Trích dẫn mảnh bên phải tự xoay 10s/lần với hiệu ứng mờ & trôi nhẹ 650ms */
    .subbar-quote-wrap {
      flex: 1;
      min-width: 0;
      display: flex;
      justify-content: flex-end;
      align-items: center;
    }

    .rotating-quote {
      font-size: 0.96rem;
      font-style: italic;
      font-weight: 400;
      line-height: 1.32;
      color: var(--text-soft);
      text-align: right;
      opacity: 1;
      transform: translate3d(0, 0, 0);
      transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }

    .rotating-quote.is-fading-out {
      opacity: 0;
      transform: translate3d(0, -5px, 0);
    }

    .rotating-quote.is-pre-enter {
      opacity: 0;
      transform: translate3d(0, 6px, 0);
      transition: none;
    }

    /* =========================================================================
       6. POPOVER MỤC LỤC 25 TAG (3 NHÓM) & DANH SÁCH NHẠC ĐĨA CÁ
       ========================================================================= */
    .popover-panel {
      position: fixed;
      top: calc(62px + env(safe-area-inset-top));
      z-index: 150;
      border-radius: 14px;
      background-color: var(--glass-panel-bg);
      border: 1px solid var(--border-card);
      box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 36px rgba(0, 0, 0, 0.56);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate3d(0, -8px, 0) scale(0.98);
      transition: opacity 0.22s ease, transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.22s ease;
    }

    .popover-panel.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate3d(0, 0, 0) scale(1);
    }

    .directory-popover {
      left: 50%;
      width: min(760px, calc(100vw - 24px));
      margin-left: calc(min(760px, calc(100vw - 24px)) / -2);
      max-height: min(72dvh, 520px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 14px 16px 16px;
    }

    .dir-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 10px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .dir-title {
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .dir-all-btn {
      padding: 4px 11px;
      border-radius: 999px;
      border: 1px solid var(--border-card);
      background-color: var(--tag-bg);
      color: var(--text-soft);
      font-size: 11px;
      transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    }

    .dir-all-btn.is-active,
    .dir-all-btn:hover {
      border-color: var(--accent);
      background-color: var(--btn-active-bg);
      color: var(--text-main);
    }

    .tag-groups-grid {
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .tag-group-title {
      font-size: 10.5px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 7px;
    }

    .tag-group-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .dir-tag-btn {
      padding: 5px 10px;
      border-radius: 6px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
      color: var(--text-soft);
      font-size: 11.5px;
      font-weight: 300;
      transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    }

    .dir-tag-btn:hover {
      border-color: var(--border-card-center);
      color: var(--text-main);
    }

    .dir-tag-btn.is-active {
      border-color: var(--accent);
      background-color: var(--btn-active-bg);
      color: var(--text-main);
      font-weight: 500;
    }

    .playlist-popover {
      right: max(14px, calc((100vw - 900px) / 2 + 46px));
      width: min(290px, calc(100vw - 24px));
      padding: 12px;
    }

    .playlist-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 8px;
      margin-bottom: 8px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .playlist-head-title {
      font-size: 10.5px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .playlist-state {
      font-size: 10px;
      color: var(--text-muted);
    }

    .playlist-items {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .track-btn {
      width: 100%;
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px solid transparent;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      text-align: left;
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .track-btn:hover {
      background-color: var(--tag-bg);
      border-color: var(--border-subtle);
    }

    .track-btn.is-current {
      background-color: var(--btn-active-bg);
      border-color: var(--border-card);
    }

    .track-meta {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .track-name {
      font-size: 12px;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .track-sub {
      font-size: 10px;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .track-indicator {
      flex-shrink: 0;
      font-size: 11px;
      color: var(--accent);
    }

    /* =========================================================================
       7. KHUNG KÍNH THỨ 2 — MENU OVERLAY (BẬT KHI BẤM ☰)
       ========================================================================= */
    .menu-overlay {
      position: fixed;
      inset: 0;
      z-index: 260;
      background-color: var(--scrim);
      display: flex;
      justify-content: flex-end;
      padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) 12px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.24s ease, visibility 0.24s ease;
    }

    .menu-overlay.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .menu-drawer {
      width: min(360px, 100%);
      height: 100%;
      border-radius: 18px;
      background-color: var(--glass-panel-bg);
      border: 1px solid var(--border-card);
      box-shadow: inset 0 1px 0 var(--glass-highlight), 0 24px 48px rgba(0, 0, 0, 0.65);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transform: translate3d(20px, 0, 0) scale(0.98);
      opacity: 0;
      transition: transform 0.26s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease;
    }

    .menu-overlay.is-open .menu-drawer {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
    }

    .menu-head {
      padding: 16px 18px 14px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-shrink: 0;
    }

    .menu-head-title {
      font-size: 1.34rem;
      font-style: italic;
      font-weight: 500;
      color: var(--text-main);
    }

    .menu-close-btn {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--border-subtle);
      color: var(--text-soft);
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .menu-close-btn:hover {
      border-color: var(--border-card-center);
      color: var(--text-main);
    }

    .menu-body {
      flex: 1;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .fish-gacha-btn {
      width: 100%;
      padding: 13px 16px;
      border-radius: 12px;
      border: 1px solid var(--border-card-center);
      background: linear-gradient(135deg, var(--btn-active-bg), var(--tag-bg));
      box-shadow: 0 0 18px var(--accent-glow);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      text-align: left;
      transition: transform 0.22s ease, border-color 0.22s ease;
    }

    .fish-gacha-btn:hover {
      border-color: var(--text-main);
      transform: translate3d(0, -1px, 0);
    }

    .fish-gacha-btn:active { transform: scale(0.98); }

    .fish-gacha-main {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .fish-gacha-title {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-main);
    }

    .fish-gacha-sub {
      font-size: 11px;
      font-weight: 300;
      color: var(--text-soft);
    }

    .menu-action-row {
      width: 100%;
      padding: 11px 13px;
      border-radius: 10px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12.5px;
      color: var(--text-main);
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .menu-action-row:hover,
    .menu-action-row.is-active {
      border-color: var(--accent);
      background-color: var(--btn-active-bg);
    }

    .menu-badge {
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid var(--border-card);
      font-size: 11px;
      color: var(--accent);
    }

    .menu-section-label {
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .recent-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .recent-item {
      width: 100%;
      padding: 8px 11px;
      border-radius: 9px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      text-align: left;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .recent-item:hover {
      border-color: var(--border-card-center);
      background-color: var(--btn-active-bg);
    }

    .recent-name { font-size: 12.5px; color: var(--text-main); }
    .recent-date { font-size: 10.5px; color: var(--text-muted); flex-shrink: 0; }

    .guide-accordion {
      border-radius: 10px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
      overflow: hidden;
    }

    .guide-trigger {
      width: 100%;
      padding: 11px 13px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12.5px;
      color: var(--text-main);
    }

    .guide-chevron {
      font-size: 10px;
      color: var(--accent);
      transition: transform 0.22s ease;
    }

    .guide-accordion.is-open .guide-chevron { transform: rotate(180deg); }

    .guide-content {
      display: none;
      padding: 0 13px 12px;
      border-top: 1px solid var(--border-subtle);
    }

    .guide-accordion.is-open .guide-content { display: block; }

    .guide-steps {
      margin-top: 10px;
      padding-left: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 300;
      line-height: 1.55;
      color: var(--text-soft);
    }

    .social-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 7px;
    }

    .social-link {
      padding: 9px 11px;
      border-radius: 9px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
      font-size: 12px;
      color: var(--text-soft);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    }

    .social-link:hover {
      border-color: var(--border-card-center);
      color: var(--text-main);
      background-color: var(--btn-active-bg);
    }

    .social-link.is-wide { grid-column: 1 / -1; }
    .social-arrow { font-size: 11px; color: var(--accent); }

    .menu-foot {
      padding: 12px 18px 14px;
      border-top: 1px solid var(--border-subtle);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      flex-shrink: 0;
    }

    .page-hook-btn {
      padding: 8px 10px;
      border-radius: 9px;
      border: 1px solid var(--border-subtle);
      color: var(--text-soft);
      font-size: 11px;
      text-align: center;
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .page-hook-btn:hover {
      border-color: var(--border-card-center);
      color: var(--text-main);
    }

    /* =========================================================================
       8. SÂN KHẤU QUẠT TRẢI BÀI (KÉO XÍCH LÊN CAO, <= 7 LÁ TRONG VÙNG NHÌN)
       ========================================================================= */
    .stage-wrap {
      flex: 1;
      position: relative;
      width: 100%;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      user-select: none;
      touch-action: pan-y;
    }

    .fan-track {
      position: relative;
      z-index: 12;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: grab;
    }

    .fan-track.is-dragging { cursor: grabbing; }

    /* Hai nút điều hướng ‹ › mảnh hai bên */
    .side-nav-btn {
      position: absolute;
      top: 46%;
      z-index: 65;
      width: 36px;
      height: 36px;
      margin-top: -18px;
      border-radius: 50%;
      background-color: var(--glass-bg);
      border: 1px solid var(--border-card);
      color: var(--text-soft);
      font-size: 19px;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.22s ease, color 0.22s ease, transform 0.2s ease, opacity 0.22s ease;
    }

    .side-nav-btn:hover { border-color: var(--accent); color: var(--text-main); }
    .side-nav-btn:active { transform: scale(0.9); }
    .side-nav-prev { left: max(14px, env(safe-area-inset-left)); }
    .side-nav-next { right: max(14px, env(safe-area-inset-right)); }

    /* Khung định vị lá bài kéo cao (top: 45%) để khít nhịp với dòng tạp chí trên */
    .card-slot {
      position: absolute;
      left: 50%;
      top: 45.5%;
      width: 274px;
      height: 438px;
      margin-left: -137px;
      margin-top: -219px;
      perspective: 1300px;
      will-change: transform, opacity;
      outline: none;
      cursor: pointer;
    }

    /* Trục lật 3D 2 mặt */
    .card-flipper {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      -webkit-transform-style: preserve-3d;
      transition: transform 0.78s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    /* Nhịp lật mặt chậm rãi 950ms dành riêng cho khoảnh khắc lật bài Câu cá */
    .card-flipper.is-cinematic-reveal {
      transition: transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-flipper.is-flipped {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      inset: 0;
      border-radius: 16px;
      overflow: hidden;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border: 1px solid var(--border-card);
      transition: border-color 0.35s ease, box-shadow 0.35s ease;
    }

    .card-slot.is-center .card-front {
      border-color: var(--border-card-center);
      box-shadow: var(--center-shadow);
    }

    .card-double-rim {
      position: absolute;
      inset: 5px;
      border-radius: 11px;
      border: 1px solid var(--border-inner);
      pointer-events: none;
      z-index: 8;
    }

    /* Mặt trước lá bài */
    .card-front {
      background: linear-gradient(178deg, var(--card-top) 0%, var(--card-bottom) 100%);
      display: flex;
      flex-direction: column;
    }

    /* Nút thả tim góc trên phải */
    .card-heart-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 15;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background-color: var(--glass-bg);
      border: 1px solid var(--border-card);
      color: var(--text-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.2s ease, color 0.2s ease, transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .card-heart-btn:hover { border-color: var(--accent); color: var(--text-main); }
    .card-heart-btn.is-saved { border-color: var(--accent); color: var(--accent); }
    .card-heart-btn.is-saved svg path { fill: currentColor; stroke: currentColor; }
    .card-heart-btn.is-bouncing { transform: scale(1.22); }

    /* Cửa sổ ảnh dáng Vòm Tàu Ngầm */
    .arch-frame {
      position: relative;
      flex: 1;
      min-height: 162px;
      margin: 14px 14px 0;
      border-radius: 132px 132px 0 0;
      overflow: hidden;
      border: 1px solid var(--border-card);
      border-bottom: none;
      background-color: var(--bg-deep);
    }

    .card-slot.tier-shallow .arch-frame { border-color: var(--pearl-rim); }
    .card-slot.tier-twilight .arch-frame { border-color: var(--border-card-center); }

    .arch-visual { position: absolute; inset: 0; }
    .arch-visual img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* Nhiễu hạt film 35mm thuần CSS siêu nhẹ (không dùng base64) */
    .film-grain {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      opacity: 0.14;
      background-image:
        radial-gradient(rgba(255, 255, 255, 0.28) 0.5px, transparent 0.5px),
        radial-gradient(rgba(0, 0, 0, 0.36) 0.5px, transparent 0.5px);
      background-size: 4px 4px, 5px 5px;
      background-position: 0 0, 2px 2px;
    }

    .arch-fade {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      background: linear-gradient(180deg, transparent 52%, rgba(4, 10, 18, 0.44) 80%, var(--card-bottom) 100%);
    }

    .art-canvas {
      position: relative;
      width: 100%;
      height: 100%;
      background: linear-gradient(174deg, var(--art-a) 0%, var(--art-b) 66%, var(--card-bottom) 100%);
      overflow: hidden;
    }

    .art-halo {
      position: absolute;
      left: 50%;
      top: 40%;
      width: 78%;
      aspect-ratio: 1 / 1;
      transform: translate3d(-50%, -50%, 0);
      border-radius: 50%;
      background: radial-gradient(circle, var(--art-glow) 0%, transparent 70%);
    }

    .art-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Đường mực nước 1px có hình thoi kim cương 1px ở giữa */
    .waterline {
      position: relative;
      z-index: 6;
      height: 1px;
      margin: 0 14px;
      background: linear-gradient(90deg, transparent 0%, var(--border-card) 16%, var(--border-card-center) 50%, var(--border-card) 84%, transparent 100%);
      flex-shrink: 0;
    }

    .waterline::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 6px;
      height: 6px;
      background-color: var(--card-bottom);
      border: 1px solid var(--accent);
      transform: translate3d(-50%, -50%, 0) rotate(45deg);
    }

    .card-info {
      position: relative;
      z-index: 6;
      padding: 13px 14px 9px;
      display: flex;
      flex-direction: column;
      gap: 7px;
      flex-shrink: 0;
    }

    .card-name {
      font-size: 1.54rem;
      font-weight: 500;
      font-style: italic;
      line-height: 1.1;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      min-height: 22px;
    }

    .archive-tag {
      display: inline-flex;
      align-items: center;
      padding: 2.5px 7px;
      border-radius: 4px;
      border: 1px solid var(--tag-border);
      background-color: var(--tag-bg);
      font-size: 9.5px;
      font-weight: 300;
      color: var(--text-soft);
      line-height: 1.25;
      white-space: nowrap;
    }

    .card-foot {
      position: relative;
      z-index: 6;
      margin: 0 14px;
      padding: 8px 0 11px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-shrink: 0;
      font-size: 10px;
    }

    .card-date { color: var(--text-muted); }

    .card-depth-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--text-soft);
    }

    .tier-glyph { color: var(--accent); letter-spacing: 0.1em; }

    /* Vệt ánh xà cừ lướt ngang mặt thẻ (Vùng chạng vạng & lúc lật bài Câu cá chậm rãi) */
    .card-sheen {
      position: absolute;
      inset: -38%;
      z-index: 7;
      pointer-events: none;
      opacity: 0;
      background: linear-gradient(
        118deg,
        transparent 36%,
        var(--sheen-color) 49%,
        rgba(255, 255, 255, 0.08) 57%,
        transparent 68%
      );
      transform: translate3d(-78%, 0, 0);
      will-change: transform, opacity;
    }

    .card-slot.tier-twilight.is-center .card-sheen {
      animation: sheenSweep 1.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .card-slot.is-sheen-burst .card-sheen {
      animation: sheenSweepSlow 1.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes sheenSweep {
      0% { opacity: 0; transform: translate3d(-74%, 0, 0); }
      28% { opacity: 0.92; }
      100% { opacity: 0; transform: translate3d(74%, 0, 0); }
    }

    @keyframes sheenSweepSlow {
      0% { opacity: 0; transform: translate3d(-80%, 0, 0); }
      24% { opacity: 1; }
      72% { opacity: 0.72; }
      100% { opacity: 0; transform: translate3d(80%, 0, 0); }
    }

    .abyss-crack {
      position: absolute;
      top: 0;
      left: 0;
      width: 82px;
      height: 82px;
      z-index: 7;
      pointer-events: none;
      opacity: 0.72;
    }

    /* Mặt lưng lá bài tối giản phong cách tạp chí */
    .card-back {
      transform: rotateY(180deg);
      background: linear-gradient(168deg, var(--card-back-top) 0%, var(--card-back-bottom) 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 20px 18px;
      text-align: center;
    }

    .back-caption {
      font-size: 8.5px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--accent);
      opacity: 0.82;
    }

    .back-emblem {
      width: 66%;
      max-width: 172px;
      color: var(--accent);
      opacity: 0.86;
    }

    /* Dòng thì thầm trạng thái trong 5 nhịp Câu cá & lời mở khóa khi lật */
    .gacha-whisper {
      position: absolute;
      left: 50%;
      bottom: max(18px, env(safe-area-inset-bottom));
      z-index: 98;
      max-width: calc(100vw - 96px);
      padding: 7px 16px;
      border-radius: 999px;
      border: 1px solid var(--border-card);
      background-color: var(--glass-bg);
      color: var(--text-main);
      font-size: 12px;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0;
      pointer-events: none;
      transform: translate3d(-50%, 10px, 0);
      transition: opacity 0.4s ease, transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .gacha-whisper.is-shown {
      opacity: 1;
      transform: translate3d(-50%, 0, 0);
    }

    .gacha-whisper.is-clickable {
      pointer-events: auto;
      cursor: pointer;
      border-color: var(--border-card-center);
    }

    .gacha-whisper-accent {
      color: var(--accent);
      margin-right: 4px;
    }

    /* Trạng thái rỗng */
    .empty-state {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 24px;
      text-align: center;
      z-index: 25;
    }

    .empty-state.is-visible { display: flex; }

    .empty-msg {
      font-size: 1.26rem;
      font-style: italic;
      color: var(--text-soft);
      max-width: 300px;
      line-height: 1.45;
    }

    .reset-btn {
      padding: 8px 16px;
      border-radius: 999px;
      border: 1px solid var(--border-card-center);
      background-color: var(--btn-active-bg);
      color: var(--text-main);
      font-size: 11.5px;
    }

    /* =========================================================================
       9. KHUNG HỒ SƠ CHI TIẾT (EDITORIAL DOSSIER — 2 TAB + STICKY FOOTER)
       ========================================================================= */
    .dossier-overlay {
      position: fixed;
      inset: 0;
      z-index: 300;
      background-color: var(--scrim);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.28s ease, visibility 0.28s ease;
    }

    .dossier-overlay.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .dossier-dialog {
      position: relative;
      width: min(640px, 100%);
      height: min(86dvh, 660px);
      border-radius: 18px;
      background-color: var(--glass-panel-bg);
      border: 1px solid var(--border-card);
      box-shadow: inset 0 1px 0 var(--glass-highlight), 0 24px 52px rgba(0, 0, 0, 0.68);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      opacity: 0;
      transform: scale(0.94);
      will-change: transform, opacity;
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
    }

    .dossier-overlay.is-open .dossier-dialog {
      opacity: 1;
      transform: scale(1);
    }

    .dossier-header {
      position: relative;
      padding: 18px 20px 14px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: flex-start;
      gap: 15px;
      flex-shrink: 0;
    }

    .dossier-mini-arch {
      position: relative;
      width: 78px;
      height: 106px;
      flex-shrink: 0;
      border-radius: 46px 46px 8px 8px;
      overflow: hidden;
      border: 1px solid var(--border-card);
      background-color: var(--bg-deep);
    }

    .dossier-head-meta {
      flex: 1;
      min-width: 0;
      padding-right: 30px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .dossier-name {
      font-size: clamp(1.64rem, 3.2vw, 2.08rem);
      font-weight: 500;
      font-style: italic;
      line-height: 1.08;
      color: var(--text-main);
    }

    .dossier-tags { display: flex; flex-wrap: wrap; gap: 5px; }

    .dossier-metrics {
      font-size: 11.5px;
      color: var(--text-soft);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }

    .metric-accent { color: var(--accent); }

    .dossier-tokens-note {
      font-size: 10px;
      font-weight: 300;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }

    .dossier-close-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--border-subtle);
      color: var(--text-soft);
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .dossier-close-btn:hover { border-color: var(--border-card-center); color: var(--text-main); }

    .dossier-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-bottom: 1px solid var(--border-subtle);
      flex-shrink: 0;
    }

    .dossier-tab-btn {
      position: relative;
      padding: 11px 12px;
      font-size: 12px;
      font-weight: 400;
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: color 0.2s ease, background-color 0.2s ease;
    }

    .dossier-tab-btn:hover { color: var(--text-soft); }
    .dossier-tab-btn.is-active { color: var(--text-main); background-color: var(--tag-bg); }

    .dossier-tab-btn.is-active::after {
      content: "";
      position: absolute;
      left: 20%;
      right: 20%;
      bottom: 0;
      height: 1.5px;
      background-color: var(--accent);
    }

    .tab-count { font-size: 10.5px; color: var(--accent); }

    .dossier-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 18px 20px 20px;
    }

    .tab-panel { display: none; }
    .tab-panel.is-active { display: block; }

    .bio-content {
      display: flex;
      flex-direction: column;
      gap: 14px;
      font-size: 13.5px;
      font-weight: 300;
      line-height: 1.84;
      color: var(--text-soft);
    }

    .bio-content p:first-child::first-letter {
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: 1.9em;
      line-height: 1;
      color: var(--accent);
      padding-right: 2px;
    }

    .feedback-form {
      padding: 13px;
      border-radius: 12px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin-bottom: 16px;
    }

    .fb-input,
    .fb-textarea {
      width: 100%;
      padding: 8px 11px;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background-color: rgba(0, 0, 0, 0.22);
      color: var(--text-main);
      font-size: 12.5px;
      font-weight: 300;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .fb-input:focus,
    .fb-textarea:focus { border-color: var(--border-card-center); }
    .fb-input::placeholder,
    .fb-textarea::placeholder { color: var(--text-dim); }
    .fb-textarea { min-height: 76px; resize: vertical; line-height: 1.55; }

    .fb-form-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .fb-char-count { font-size: 10.5px; color: var(--text-muted); }

    .fb-submit-btn {
      padding: 7px 16px;
      border-radius: 999px;
      border: 1px solid var(--border-card-center);
      background-color: var(--btn-active-bg);
      color: var(--text-main);
      font-size: 12px;
      transition: border-color 0.2s ease, opacity 0.2s ease;
    }

    .fb-submit-btn:hover { border-color: var(--text-main); }
    .fb-submit-btn:disabled { opacity: 0.48; pointer-events: none; }

    .feedback-list { display: flex; flex-direction: column; gap: 10px; }

    .fb-card {
      padding: 12px 13px;
      border-radius: 10px;
      border: 1px solid var(--border-subtle);
      background-color: var(--tag-bg);
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .fb-card-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
    }

    .fb-author { font-size: 12px; font-weight: 500; color: var(--accent); }
    .fb-time { font-size: 10px; color: var(--text-dim); flex-shrink: 0; }

    .fb-text {
      font-size: 12.6px;
      font-weight: 300;
      line-height: 1.62;
      color: var(--text-soft);
      white-space: pre-wrap;
      word-break: break-word;
    }

    .fb-empty {
      text-align: center;
      padding: 18px 10px;
      font-size: 12.5px;
      font-style: italic;
      color: var(--text-muted);
    }

    .dossier-footer {
      padding: 12px 18px;
      border-top: 1px solid var(--border-subtle);
      background-color: var(--glass-elevated);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .footer-heart-btn {
      height: 40px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid var(--border-card);
      background-color: var(--tag-bg);
      color: var(--text-soft);
      font-size: 12.5px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
      transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    }

    .footer-heart-btn:hover { border-color: var(--accent); color: var(--text-main); }

    .footer-heart-btn.is-saved {
      border-color: var(--accent);
      background-color: var(--btn-active-bg);
      color: var(--accent);
    }

    .footer-heart-btn.is-saved svg path { fill: currentColor; stroke: currentColor; }

    .footer-chat-btn {
      flex: 1;
      height: 40px;
      padding: 0 18px;
      border-radius: 999px;
      border: 1px solid var(--border-card-center);
      background: linear-gradient(135deg, var(--btn-active-bg), rgba(255, 255, 255, 0.04));
      box-shadow: 0 0 18px var(--accent-glow);
      color: var(--text-main);
      font-size: 13px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .footer-chat-btn:hover {
      border-color: var(--text-main);
      transform: translate3d(0, -1px, 0);
    }

    /* Toast dịu mắt thay thế hoàn toàn alert() */
    .toast-note {
      position: fixed;
      left: 50%;
      bottom: 64px;
      z-index: 420;
      max-width: calc(100vw - 32px);
      padding: 9px 16px;
      border-radius: 999px;
      background-color: var(--glass-panel-bg);
      border: 1px solid var(--border-card);
      color: var(--text-main);
      font-size: 11.5px;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transform: translate3d(-50%, 8px, 0);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .toast-note.is-shown {
      opacity: 1;
      transform: translate3d(-50%, 0, 0);
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-card); border-radius: 99px; }

    /* =========================================================================
       10. RESPONSIVE ĐIỆN THOẠI DỌC (360px - 768px)
       ========================================================================= */
    @media (max-width: 768px) {
      .topbar-outer { padding: 8px 10px 0; gap: 6px; }

      .glass-bar {
        height: 44px;
        padding: 0 6px;
        gap: 5px;
        border-radius: 13px;
      }

      .bar-divider { display: none; }
      .bar-search { padding: 0 7px; height: 30px; gap: 4px; }
      .bar-search input { font-size: 11.5px; }

      .dir-btn {
        height: 30px;
        padding: 0 8px;
        font-size: 11px;
        max-width: 96px;
      }

      .fish-disc-btn { width: 26px; height: 26px; }
      .fish-disc-spinner { width: 22px; height: 22px; }
      .music-toggle-btn { width: 22px; height: 22px; }
      .menu-btn { width: 30px; height: 30px; }

      .editorial-subbar {
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 1px 4px 7px;
      }

      .subbar-left {
        width: 100%;
        justify-content: space-between;
        align-items: center;
      }

      .brand-whisper { font-size: 0.98rem; }

      .subbar-quote-wrap {
        width: 100%;
        justify-content: center;
      }

      .rotating-quote {
        text-align: center;
        font-size: 0.88rem;
        line-height: 1.3;
        min-height: 2.4em;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .popover-panel { top: calc(58px + env(safe-area-inset-top)); }
      .playlist-popover { right: 10px; }

      .shell-backdrop {
        width: 108vw;
        top: 46%;
        transform: translate3d(-50%, -46%, 0);
      }

      .card-slot {
        top: 46%;
        width: clamp(224px, 65vw, 250px);
        height: clamp(354px, 56dvh, 404px);
        margin-left: calc(clamp(224px, 65vw, 250px) / -2);
        margin-top: calc(clamp(354px, 56dvh, 404px) / -2);
      }

      .arch-frame { margin: 12px 12px 0; min-height: 140px; }
      .waterline { margin: 0 12px; }
      .card-info { padding: 11px 12px 8px; gap: 6px; }
      .card-name { font-size: 1.38rem; }
      .card-foot { margin: 0 12px; padding: 7px 0 10px; }
      .card-heart-btn { top: 10px; right: 10px; width: 28px; height: 28px; }

      .side-nav-btn {
        width: 30px;
        height: 30px;
        margin-top: -15px;
        font-size: 17px;
      }
      .side-nav-prev { left: 8px; }
      .side-nav-next { right: 8px; }

      .gacha-whisper {
        max-width: calc(100vw - 28px);
        bottom: max(54px, calc(env(safe-area-inset-bottom) + 46px));
        font-size: 11px;
        white-space: normal;
        line-height: 1.38;
      }

      .dossier-overlay { padding: 10px; }
      .dossier-dialog { height: min(90dvh, 680px); border-radius: 16px; }
      .dossier-header { padding: 14px 14px 12px; gap: 12px; }
      .dossier-mini-arch { width: 66px; height: 90px; }
      .dossier-body { padding: 14px 15px 16px; }
      .dossier-footer { padding: 10px 14px; }
      .footer-chat-btn { font-size: 12px; padding: 0 12px; }

      .theme-orbs { right: 14px; bottom: 13px; }
    }
  </style>
</head>
<body>

  <!-- ==================== 1. HẬU CẢNH ĐẠI DƯƠNG SIÊU NHẸ ==================== -->
  <div class="ocean-bg" aria-hidden="true"></div>
  <div class="god-rays" aria-hidden="true">
    <div class="god-ray god-ray-1"></div>
    <div class="god-ray god-ray-2"></div>
  </div>
  <div class="depth-veil" aria-hidden="true"></div>

  <!-- Hai vòng sóng 1px đồng tâm bung tỏa khi đổi màu & lật bài Câu cá -->
  <div id="wave-ring-1" class="wave-ring" aria-hidden="true"></div>
  <div id="wave-ring-2" class="wave-ring" aria-hidden="true"></div>

  <!-- 2 viên ngọc đổi màu góc dưới phải (KHÔNG CHỮ, NGOÀI MỌI KHUNG KÍNH) -->
  <div class="theme-orbs" role="group" aria-label="Chọn chế độ màu đại dương">
    <button type="button" class="orb-btn orb-blue is-active" data-theme-target="blue-sea" aria-label="Biển Xanh"></button>
    <button type="button" class="orb-btn orb-red" data-theme-target="red-sea" aria-label="Red Sea"></button>
  </div>

  <!-- ==================== 2. KHUNG CHÍNH TRANG 3 ==================== -->
  <div class="page-shell">

    <!-- Thanh kính chung trên cùng + Dòng thông số tạp chí 2 đầu -->
    <header class="topbar-outer">
      <div class="glass-bar">
        <!-- Cụm 1: Tìm kiếm -->
        <div class="bar-search">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
          </svg>
          <input id="search-input" type="search" placeholder="Tìm tên, tag..." aria-label="Tìm nhân vật hoặc thẻ" />
          <button id="search-clear" type="button" class="search-clear-btn" aria-label="Xóa từ khóa">✕</button>
        </div>

        <span class="bar-divider" aria-hidden="true"></span>

        <!-- Cụm 2: Mục lục ▾ (25 tag chia 3 nhóm) -->
        <button id="dir-btn" type="button" class="dir-btn" aria-expanded="false" aria-controls="dir-popover">
          <span id="dir-btn-label" class="dir-btn-label">Mục lục</span>
          <span class="dir-caret" aria-hidden="true">▾</span>
        </button>

        <span class="bar-divider" aria-hidden="true"></span>

        <!-- Cụm 3: Đĩa nhạc con cá xoay tròn + nút dừng/phát -->
        <div class="music-cluster">
          <button id="fish-disc-btn" type="button" class="fish-disc-btn" title="Chọn bài hát khác" aria-label="Mở danh sách nhạc" aria-expanded="false" aria-controls="playlist-popover">
            <span class="fish-disc-spinner" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="13.5" stroke-opacity="0.34" stroke-dasharray="3 4" />
                <path d="M9.5 16c2.6-4.2 8.2-4.6 12.6-1.2 1.2 1 1.2 1.4 0 2.4-4.4 3.4-10 3-12.6-1.2Z" />
                <path d="M9.5 16 5.8 12.8m3.7 3.2-3.7 3.2" />
                <circle cx="18.8" cy="15.2" r="0.9" fill="currentColor" stroke="none" />
              </svg>
            </span>
          </button>
          <button id="music-toggle-btn" type="button" class="music-toggle-btn" aria-label="Phát hoặc dừng nhạc">▶</button>
        </div>

        <!-- Cụm 4: Nút ☰ mở Khung Kính thứ 2 -->
        <button id="menu-btn" type="button" class="menu-btn" aria-label="Mở bảng menu" aria-expanded="false" aria-controls="menu-overlay">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>

      <!-- Dòng thông số tạp chí cân 2 đầu: Trái (Tên + Chỉ số thẻ) · Phải (6 câu trích dẫn xoay 10s/lần) -->
      <div class="editorial-subbar">
        <div class="subbar-left">
          <span class="brand-whisper font-serif">Ariel không biết bơi</span>
          <span id="live-card-status" class="live-card-status tabular">
            <strong>01</strong> / 10 · -1.420m
          </span>
          <span id="active-filter-pill" class="active-filter-pill">
            <span id="active-filter-text"></span>
            <button id="clear-filter-pill" type="button" aria-label="Bỏ lọc">✕</button>
          </span>
        </div>

        <div class="subbar-quote-wrap">
          <p id="rotating-quote" class="rotating-quote font-serif" aria-live="polite"></p>
        </div>
      </div>
    </header>

    <!-- Popover Bảng Mục Lục 25 Tag -->
    <section id="dir-popover" class="popover-panel directory-popover" aria-label="Mục lục 25 thể loại">
      <div class="dir-header">
        <span class="dir-title">Mục lục đáy biển · 25 thẻ</span>
        <button id="dir-all-btn" type="button" class="dir-all-btn is-active">Tất cả</button>
      </div>
      <div id="tag-groups-grid" class="tag-groups-grid"></div>
    </section>

    <!-- Popover Danh Sách Nhạc -->
    <section id="playlist-popover" class="popover-panel playlist-popover" aria-label="Danh sách bài hát">
      <div class="playlist-head">
        <span class="playlist-head-title">Đĩa nhạc đáy biển</span>
        <span id="playlist-state" class="playlist-state">Đang dừng</span>
      </div>
      <div id="playlist-items" class="playlist-items"></div>
    </section>

    <!-- Sân khấu Quạt Trải Bài + Nền Vỏ Sò Kiến Trúc & Hải Đồ 1px Cỡ Lớn -->
    <main class="stage-wrap">

      <!-- Hậu cảnh Vỏ Sò + Vòng Cung Hải Đồ kiến trúc nét mảnh 1px (1 SVG duy nhất) -->
      <div class="shell-backdrop" aria-hidden="true">
        <svg viewBox="0 0 840 660" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Nhóm vòng cung tọa độ hải đồ xoay khớp nhẹ theo nhịp vuốt bài -->
          <g id="nautical-ring">
            <circle cx="420" cy="520" r="446" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.16" />
            <circle cx="420" cy="520" r="416" stroke="currentColor" stroke-width="0.65" stroke-dasharray="2 10" stroke-opacity="0.20" />
            <circle cx="420" cy="520" r="356" stroke="currentColor" stroke-width="0.55" stroke-opacity="0.12" />
            <g id="nautical-ticks" stroke="currentColor" stroke-width="0.7"></g>
            <!-- Dấu kim cương tọa độ la bàn -->
            <path d="M420 68 L424.5 74 L420 80 L415.5 74 Z" stroke="currentColor" stroke-width="0.85" stroke-opacity="0.28" />
